# Orchestra MCP Server Configuration

# Child server paths
REGNETAGENTS_SERVER_PATH=C:\Dev\RegNetAgents\regnetagents_langgraph_mcp_server.py
CASCADE_SERVER_PATH=C:\Dev\CASCADE\cascade_langgraph_mcp_server.py

# Optional LLM synthesis in _generate_report (default: false)
# When false: returns formatted structured text; Claude Desktop handles narration.
# When true: prepends a biological narrative — useful for standalone script runs.
USE_LLM_SYNTHESIS=false

# LLM provider (only used when USE_LLM_SYNTHESIS=true)
# Same pattern as CASCADE (USE_LLM_INSIGHTS) and RegNetAgents (USE_LLM_AGENTS)
LLM_PROVIDER=ollama              # ollama (default) | anthropic
LLM_MODEL=llama3.1:8b            # model name; for anthropic: claude-haiku-4-5-20251001
LLM_API_KEY=                     # required only when LLM_PROVIDER=anthropic

# Ollama settings (used when LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TEMPERATURE=0.3
OLLAMA_MAX_TOKENS=2000
OLLAMA_TIMEOUT=60
# OLLAMA_API_KEY=                # optional: set to use Ollama Cloud instead of local

# Timeouts (seconds) — per-tool, matches latency budget in mcp_client.py
REGNETAGENTS_TIMEOUT=20
CASCADE_TIMEOUT=30

# SSL verification bypass — set to 1 on networks with corporate SSL inspection
# (e.g. machines where string-db.org or GitHub HTTPS connections fail with cert errors)
# Only use on internal/trusted networks.
# ORCHESTRA_SSL_NO_VERIFY=1
